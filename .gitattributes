# ============================================================
# ILVES — .gitattributes（Unity 6.3 LTS / 6000.3.27f1）
# 需要 Git LFS（本机 git-lfs 3.8.0 已安装，全局 filter.lfs.* 已配置）
# ============================================================

# 默认：按文本处理，交给 Git 做换行归一
* text=auto

# ---------- 文本源码 ----------
*.cs       text diff=csharp eol=lf
*.shader   text eol=lf
*.cginc    text eol=lf
*.hlsl     text eol=lf
*.compute  text eol=lf
*.asmdef   text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf

# ---------- Unity YAML 资产：禁止换行转换（由 Unity 决定字节） ----------
*.unity      -text
*.prefab     -text
*.asset      -text
*.mat        -text
*.anim       -text
*.controller -text
*.overrideController -text
*.physicMaterial -text
*.mask       -text
*.meta       -text

# ---------- GitHub 语言统计 / 差异显示 ----------
*.csproj linguist-generated=true
*.sln    linguist-generated=true

# ============================================================
# Git LFS 大二进制资产（按任务要求：psd/png/jpg/tga/fbx/wav/mp3/mp4/exr）
# 说明：首次 push 前需 git lfs install（本机已全局配置）
# ============================================================
*.psd  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
# 字体（内置中文字体 ~16MB）
*.otf  filter=lfs diff=lfs merge=lfs -text
*.ttf  filter=lfs diff=lfs merge=lfs -text
